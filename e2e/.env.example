# ============================================================
# E2E Test Environment Variables
# Copy this file to .env and fill in your local values.
# ============================================================

# web app (frontend/apps/web)
BASE_URL=http://127.0.0.1:5173

# Backend API URL (FastAPI / uvicorn)
API_URL=http://127.0.0.1:8080

# Supabase (from `supabase status` after running `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-secret-key-here

# Login smoke user (supabase/python_seeds/data/_001_data_users.py)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=password123

# Record Playwright videos into e2e/videos/<timestamp>/ (previous runs are kept)
# E2E_VIDEO=1
# Distinct JPEG frames next to each video (needs ffmpeg; implies video)
# E2E_IMAGES=1
